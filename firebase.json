{
  "functions": {
    "source": "functions",
    "predeploy": [],
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "skills-lock.json",
      "*.md",
      "**/.*",
      ".git",
      ".git/**",
      ".claude/**",
      "**/node_modules/**",
      "functions/**",
      "leads_bot/**",
      "ARCHIV_ALTE_DATEIEN/**",
      "_archiv/**",
      "ref/**",
      "kunden/**",
      "MD/**",
      "scripts/**",
      "n8n/**",
      "**/*.exe",
      "**/*.bat",
      "**/*.sh",
      "**/*.dll"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
