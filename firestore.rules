rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(customerId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == customerId;
    }

    // Modul-basierte Access Control
    function hasModuleEnabled(customerId, moduleName) {
      let customer = get(/databases/$(database)/documents/customers/$(customerId)).data;
      return customer.modules[moduleName] == true;
    }

    // ========================================================================
    // USERS Collection (Admin-Verwaltung)
    // ========================================================================
    match /users/{userId} {
      // Lesen: User darf eigene Daten lesen, Admin darf alle lesen
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId || isAdmin());

      // Schreiben: Nur Admin darf Users erstellen/ändern
      allow write: if isAdmin();
    }

    // ========================================================================
    // CUSTOMERS Collection (Kunden-Stammdaten)
    // ========================================================================
    match /customers/{customerId} {
      // Lesen: Kunde darf eigene Daten lesen, Admin darf alle lesen
      allow read: if isOwner(customerId) || isAdmin();

      // Update: Kunde darf Profil ändern, aber NICHT modules-Feld
      allow update: if (isOwner(customerId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['modules']))
                    || isAdmin();

      // Erstellen/Löschen: Nur Admin
      allow create, delete: if isAdmin();
    }

    // ========================================================================
    // CALLS Collection (Voice-Gespräche)
    // ========================================================================
    match /calls/{callId} {
      // Lesen: Kunde darf nur eigene Calls lesen UND voice-Modul muss aktiv sein
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.customerId) &&
                      hasModuleEnabled(resource.data.customerId, 'voice'))
                     || isAdmin();

      // Schreiben: Admin oder Cloud Functions (für Testing/Seeding)
      allow write: if isAdmin();
    }

    // ========================================================================
    // TICKETS Collection (Support-Tickets)
    // ========================================================================
    match /tickets/{ticketId} {
      // Lesen: Kunde darf eigene Tickets lesen UND support-Modul muss aktiv sein
      allow read: if isAuthenticated() &&
                     ((isOwner(resource.data.customerId) &&
                       hasModuleEnabled(resource.data.customerId, 'support'))
                      || isAdmin());

      // Erstellen: Kunde darf eigene Tickets erstellen (wenn support-Modul aktiv)
      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.customerId) &&
                       hasModuleEnabled(request.resource.data.customerId, 'support') &&
                       request.resource.data.status == 'open';

      // Update: Kunde darf eigene Tickets aktualisieren (updatedAt), Admin alle
      allow update: if isAuthenticated() &&
                       ((isOwner(resource.data.customerId) &&
                         hasModuleEnabled(resource.data.customerId, 'support'))
                        || isAdmin());

      // Löschen: Nur Admin
      allow delete: if isAdmin();

      // Subcollection: messages
      match /messages/{messageId} {
        // Lesen: Kunde darf Nachrichten eigener Tickets lesen
        allow read: if isAuthenticated() &&
                       (isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId) || isAdmin());

        // Erstellen: Kunde & Admin dürfen Nachrichten hinzufügen
        allow create: if isAuthenticated() &&
                         (isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId) || isAdmin());

        // Update/Delete: Nur Admin
        allow update, delete: if isAdmin();
      }
    }

    // ========================================================================
    // INVOICES Collection (Rechnungen)
    // ========================================================================
    match /invoices/{invoiceId} {
      // Lesen: Kunde darf nur eigene Rechnungen lesen UND invoices-Modul muss aktiv sein
      allow read: if isAuthenticated() &&
                     ((isOwner(resource.data.customerId) &&
                       hasModuleEnabled(resource.data.customerId, 'invoices'))
                      || isAdmin());

      // Erstellen/Ändern: Nur Admin darf Rechnungen verwalten
      allow create, update: if isAdmin();

      // Löschen: Nur Admin
      allow delete: if isAdmin();
    }

    // ========================================================================
    // CUSTOMER_MODULES Collection (Modul-Aktivierungen)
    // ========================================================================
    match /customer_modules/{customerId} {
      // Lesen: Kunde darf eigene Module lesen, Admin darf alle lesen
      allow read: if isOwner(customerId) || isAdmin();

      // Schreiben: Nur Admin
      allow write: if isAdmin();
    }

    // ========================================================================
    // Default: Alles andere ablehnen
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
