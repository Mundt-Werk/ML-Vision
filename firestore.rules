rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(customerId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == customerId;
    }

    // Modul-basierte Access Control
    function hasModuleEnabled(customerId, moduleName) {
      let customer = get(/databases/$(database)/documents/customers/$(customerId)).data;
      return customer.modules[moduleName] == true;
    }

    // ========================================================================
    // USERS Collection (Admin-Verwaltung)
    // ========================================================================
    match /users/{userId} {
      // Lesen: User darf eigene Daten lesen, Admin darf alle lesen
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId || isAdmin());

      // Schreiben: Nur Admin darf Users erstellen/ändern
      allow write: if isAdmin();
    }

    // ========================================================================
    // CUSTOMERS Collection (Kunden-Stammdaten)
    // ========================================================================
    match /customers/{customerId} {
      // Lesen: Kunde darf eigene Daten lesen, Admin darf alle lesen
      allow read: if isOwner(customerId) || isAdmin();

      // Update: Kunde darf Profil ändern, aber NICHT modules-Feld
      allow update: if (isOwner(customerId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['modules']))
                    || isAdmin();

      // Erstellen/Löschen: Nur Admin
      allow create, delete: if isAdmin();
    }

    // ========================================================================
    // CALLS Collection (Voice-Gespräche)
    // ========================================================================
    match /calls/{callId} {
      // Lesen: Kunde darf nur eigene Calls lesen UND voice-Modul muss aktiv sein
      // Für List-Queries: Prüfe ob User eine customerId hat
      allow read: if isAuthenticated() && (
                     (isAdmin()) ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == resource.data.customerId &&
                      hasModuleEnabled(resource.data.customerId, 'voice'))
                   );

      // Schreiben: Admin oder Cloud Functions (für Testing/Seeding)
      allow write: if isAdmin();
    }

    // ========================================================================
    // TICKETS Collection (Support-Tickets)
    // ========================================================================
    match /tickets/{ticketId} {
      // Lesen: Kunde darf eigene Tickets lesen UND support-Modul muss aktiv sein
      allow read: if isAuthenticated() && (
                     (isAdmin()) ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == resource.data.customerId &&
                      hasModuleEnabled(resource.data.customerId, 'support'))
                   );

      // Erstellen: Kunde darf eigene Tickets erstellen (wenn support-Modul aktiv)
      allow create: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == request.resource.data.customerId &&
                       hasModuleEnabled(request.resource.data.customerId, 'support') &&
                       request.resource.data.status == 'open';

      // Update: Kunde darf eigene Tickets aktualisieren (updatedAt), Admin alle
      allow update: if isAuthenticated() && (
                       (isAdmin()) ||
                       (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == resource.data.customerId &&
                        hasModuleEnabled(resource.data.customerId, 'support'))
                     );

      // Löschen: Nur Admin
      allow delete: if isAdmin();

      // Subcollection: messages
      match /messages/{messageId} {
        // Lesen: Kunde darf Nachrichten eigener Tickets lesen
        allow read: if isAuthenticated() && (
                       (isAdmin()) ||
                       (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId)
                     );

        // Erstellen: Kunde & Admin dürfen Nachrichten hinzufügen
        allow create: if isAuthenticated() && (
                         (isAdmin()) ||
                         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId)
                       );

        // Update/Delete: Nur Admin
        allow update, delete: if isAdmin();
      }
    }

    // ========================================================================
    // INVOICES Collection (Rechnungen)
    // ========================================================================
    match /invoices/{invoiceId} {
      // Lesen: Kunde darf nur eigene Rechnungen lesen UND invoices-Modul muss aktiv sein
      allow read: if isAuthenticated() && (
                     (isAdmin()) ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == resource.data.customerId &&
                      hasModuleEnabled(resource.data.customerId, 'invoices'))
                   );

      // Erstellen/Ändern: Nur Admin darf Rechnungen verwalten
      allow create, update: if isAdmin();

      // Löschen: Nur Admin
      allow delete: if isAdmin();
    }

    // ========================================================================
    // CUSTOMER_MODULES Collection (Modul-Aktivierungen)
    // ========================================================================
    match /customer_modules/{customerId} {
      // Lesen: Kunde darf eigene Module lesen, Admin darf alle lesen
      allow read: if isOwner(customerId) || isAdmin();

      // Schreiben: Nur Admin
      allow write: if isAdmin();
    }

    // ========================================================================
    // SALES_LEADS Collection (Kunden-Stammdaten — customers.html)
    // ========================================================================
    match /sales_leads/{leadId} {
      allow read, write: if isAdmin();
    }

    // ========================================================================
    // LEADS Collection (Leads Bot — leads-bot.html)
    // ========================================================================
    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }

    // ========================================================================
    // LEAD_SEARCHES Collection (Suchhistorie — leads-bot.html)
    // ========================================================================
    match /lead_searches/{searchId} {
      allow read, write: if isAdmin();
    }

    // ========================================================================
    // SYSTEM_SETTINGS Collection (Admin-Konfiguration — settings.html)
    // ========================================================================
    match /system_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ========================================================================
    // AUDIT_LOGS Collection (Aktionsprotokoll — audit.js)
    // ========================================================================
    match /audit_logs/{logId} {
      // Nur Admin lesen — schreiben erlaubt für alle eingeloggten Admins
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit-Logs sind unveränderlich
    }

    // ========================================================================
    // QUOTES Collection (Preisangebote — pricing-calculator.html, Phase 6)
    // ========================================================================
    match /quotes/{quoteId} {
      allow read, write: if isAdmin();
    }

    // ========================================================================
    // Default: Alles andere ablehnen
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
